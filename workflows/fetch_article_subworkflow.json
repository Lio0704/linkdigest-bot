        "language": "pythonNative",
        "pythonCode": "# Collapse whitespace, count words, keep the first 6000 characters for the model.\nMAX_CHARS = 6000\nMIN_WORDS = 150   # fewer words = blocked, paywalled or JavaScript-only page\n\nj = _items[0][\"json\"]\ntitle = \" \".join(str(j.get(\"title\") or \"\").split())\nbody = \" \".join(str(j.get(\"body\") or \"\").split())\nwords = len(body.split())\n\nreturn [{\"json\": {\n    \"title\": title[:200],\n    \"text\": body[:MAX_CHARS],\n    \"word_count\": words,\n    \"status\": \"ok\" if words >= MIN_WORDS else \"too_short\",\n    \"source\": \"direct\",\n}}]"
