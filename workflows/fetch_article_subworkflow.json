    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Jina Reader returns: \"Title: ...\", \"URL Source: ...\", then \"Markdown Content:\" and the article.\nMAX_CHARS = 6000\nMIN_WORDS = 150\n\nraw = str(_items[0][\"json\"].get(\"data\") or \"\")\ntitle = \"\"\nfor line in raw.split(\"\\n\"):\n    if line.startswith(\"Title:\"):\n        title = line[6:].strip()\n        break\ncontent = raw.split(\"Markdown Content:\", 1)[1] if \"Markdown Content:\" in raw else raw\ncontent = \" \".join(content.split())\nwords = len(content.split())\n\nreturn [{\"json\": {\n    \"title\": title[:200],\n    \"text\": content[:MAX_CHARS],\n    \"word_count\": words,\n    \"status\": \"ok\" if words >= MIN_WORDS else \"fetch_failed\",\n    \"source\": \"jina\",\n}}]"
      },
