    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Find the first http(s) link in the message, clean it, and block internal addresses.\nTRACKING = (\"utm_\", \"fbclid\", \"gclid\", \"mc_cid\", \"mc_eid\")\nBLOCKED_PREFIXES = (\"localhost\", \"127.\", \"10.\", \"192.168.\", \"169.254.\", \"0.\")\n\nmsg = _items[0][\"json\"].get(\"message\") or {}\ntext = str(msg.get(\"text\") or \"\")\nchat_id = (msg.get(\"chat\") or {}).get(\"id\")\n\n# 1. First word that starts with http:// or https://\nurl = \"\"\nfor word in text.replace(\"\\n\", \" \").split(\" \"):\n    w = word.strip().lstrip(\"<(\\\"'\").rstrip(\".,!?;:\\\"'>\")\n    if w.lower().startswith(\"http://\") or w.lower().startswith(\"https://\"):\n        url = w\n        break\n\n# 2. Host = part between :// and the first / ? or #\nhost = \"\"\nif url:\n    rest = url.split(\"://\", 1)[1]\n    for sep in (\"/\", \"?\", \"#\"):\n        rest = rest.split(sep, 1)[0]\n    host = rest.split(\"@\")[-1].split(\":\")[0].lower()\n\n# 3. Is it a public website?\nreason = \"\"\nif not url:\n    reason = \"no link found\"\nelif \".\" not in host:\n    reason = \"not a public website\"   # Docker service names, localhost...\nelif host.startswith(BLOCKED_PREFIXES):\n    reason = \"private address\"\nelif host.startswith(\"172.\"):\n    part = host.split(\".\")[1]\n    if part.isdigit() and 16 <= int(part) <= 31:\n        reason = \"private address\"\n\n# 4. Drop the #fragment and tracking parameters\nclean = url.split(\"#\", 1)[0]\nif \"?\" in clean:\n    base, query = clean.split(\"?\", 1)\n    kept = [p for p in query.split(\"&\") if p and not p.lower().startswith(TRACKING)]\n    clean = base + (\"?\" + \"&\".join(kept) if kept else \"\")\n\nreturn [{\"json\": {\n    \"chat_id\": chat_id,\n    \"url\": clean,\n    \"valid\": reason == \"\",\n    \"reason\": reason,\n}}]"
      },
