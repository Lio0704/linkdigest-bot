    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Never trust what the model wrote: clean the summary and tags, compute the rest ourselves.\nj = _items[0][\"json\"]\n\nsummary = \" \".join(str(j.get(\"summary\") or \"\").split())[:600]\n\ntags = []\nfor raw in (j.get(\"tags\") or []):\n    t = \"\".join(c for c in str(raw).lower() if c.isalnum() or c in \"- \")\n    t = \"-\".join(t.split())                 # \"control systems\" -> \"control-systems\"\n    if t and t not in tags:\n        tags.append(t)\ntags = tags[:5]\n\nurl = str(j.get(\"url\") or \"\")\ntitle = \" \".join(str(j.get(\"title\") or \"\").split()) or url\nwords = int(j.get(\"word_count\") or 0)\nminutes = max(1, round(words / 220))      # reading time, computed here, not by the AI\nstatus = \"summarised\" if summary else \"ai_failed\"\n\ndef esc(s):\n    # HTML mode: only these three characters need escaping\n    return str(s).replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n\nhashtags = \" \".join(\"#\" + t.replace(\"-\", \"_\") for t in tags)\nreply = (\"📚 <b>\" + esc(title) + \"</b>\\n⏱ \" + str(minutes) + \" min read\\n\\n\"\n         + esc(summary) + \"\\n\\n\" + esc(hashtags) + \"\\n🔗 \" + esc(url))\n\nreturn [{\"json\": {\n    \"chat_id\": j.get(\"chat_id\"),\n    \"url\": url,\n    \"title\": title,\n    \"summary\": summary,\n    \"tags\": \", \".join(tags),\n    \"word_count\": words,\n    \"status\": status,\n    \"reply\": reply,\n}}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
