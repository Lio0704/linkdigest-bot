    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Turn the user's saved rows into one Telegram message (HTML mode).\ndef esc(s):\n    return str(s).replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n\nitems = [i[\"json\"] for i in _items]\nfirst = items[0] if items else {}\nmode = str(first.get(\"mode\") or \"list\")\nkeyword = str(first.get(\"keyword\") or \"\").strip().lower()\n\nrows = [r for r in items if r.get(\"url\")]   # skip the empty item when nothing is saved\nrows.reverse()                              # newest first: the sheet appends at the bottom\n\nif mode == \"search\" and not keyword:\n    return [{\"json\": {\"reply\": esc(\"Usage: /search <keyword>, for example /search ai\")}}]\n\nif mode == \"search\":\n    found = []\n    for r in rows:\n        haystack = (str(r.get(\"title\") or \"\") + \" \" + str(r.get(\"tags\") or \"\") + \" \"\n                    + str(r.get(\"summary\") or \"\")).lower()\n        if keyword in haystack:\n            found.append(r)\n    rows = found\n\nrows = rows[:10]\n\nif not rows:\n    if mode == \"search\":\n        reply = \"No saved article matches “\" + esc(keyword) + \"”.\"\n    else:\n        reply = \"Your library is empty. Send me a link to save your first article!\"\nelse:\n    head = \"🔎 <b>Results for “\" + esc(keyword) + \"”</b>\" if mode == \"search\" else \"📚 <b>Your latest saves</b>\"\n    lines = [head, \"\"]\n    for n, r in enumerate(rows, 1):\n        title = str(r.get(\"title\") or r.get(\"url\"))\n        flag = \"\" if r.get(\"status\") == \"summarised\" else \" (link only)\"\n        lines.append(str(n) + \". \" + esc(title) + flag)\n        lines.append(\"    \" + esc(r.get(\"url\")))\n    reply = \"\\n\".join(lines)\n\nreturn [{\"json\": {\"reply\": reply}}]"
      },
